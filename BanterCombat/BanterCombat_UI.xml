<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
  <Frame name="BanterCombatPopup" parent="UIParent" frameStrata="DIALOG" enableMouse="true" movable="true" hidden="true">
    <Size x="460" y="190"/>
    <Anchors>
      <Anchor point="CENTER" relativePoint="CENTER" x="0" y="20"/>
    </Anchors>
    <Layers>
      <Layer level="BACKGROUND">
        <Texture name="$parentPaperTop" parentKey="PaperTop"/>
        <Texture name="$parentPaperMid" parentKey="PaperMid"/>
        <Texture name="$parentPaperBot" parentKey="PaperBot"/>
        <Texture name="$parentEdgeGlow" parentKey="EdgeGlow" hidden="true" setAllPoints="true">
          <Color r="0.2" g="0.15" b="0.05" a="0.35"/>
        </Texture>
      </Layer>
      <Layer level="BORDER">
        <Texture name="$parentPortrait" parentKey="Portrait">
          <Size x="42" y="42"/>
          <Anchors>
            <Anchor point="TOPLEFT" x="78" y="-28"/>
          </Anchors>
        </Texture>
      </Layer>
      <Layer level="ARTWORK">
        <Texture name="$parentHeader" parentKey="Header" hidden="true">
          <Size x="320" y="46"/>
          <Anchors>
            <Anchor point="TOP" x="18" y="-14"/>
          </Anchors>
        </Texture>
      </Layer>
      <Layer level="OVERLAY">
        <Texture name="$parentMedal" parentKey="Medal">
          <Size x="16" y="16"/>
          <Anchors>
            <Anchor point="TOPLEFT" x="128" y="-18"/>
          </Anchors>
        </Texture>
        <FontString name="$parentBadge" parentKey="Badge" inherits="GameFontNormal" justifyH="LEFT">
          <Size x="250" y="14"/>
          <Anchors>
            <Anchor point="LEFT" relativeTo="$parentMedal" relativePoint="RIGHT" x="4" y="0"/>
          </Anchors>
        </FontString>
        <FontString name="$parentSpeaker" parentKey="Speaker" inherits="GameFontHighlight" justifyH="LEFT">
          <Size x="250" y="18"/>
          <Anchors>
            <Anchor point="LEFT" relativeTo="$parentPortrait" relativePoint="RIGHT" x="10" y="6"/>
          </Anchors>
        </FontString>
        <FontString name="$parentText" parentKey="Text" inherits="GameFontHighlightSmall" justifyH="LEFT" justifyV="TOP">
          <Size x="300" y="72"/>
          <Anchors>
            <Anchor point="TOPLEFT" x="78" y="-78"/>
          </Anchors>
        </FontString>
      </Layer>
    </Layers>
    <Frames>
      <PlayerModel name="$parentModel" parentKey="Model" hidden="true">
        <Size x="42" y="42"/>
        <Anchors>
          <Anchor point="TOPLEFT" x="78" y="-28"/>
        </Anchors>
      </PlayerModel>
    </Frames>
    <Scripts>
      <OnLoad>
        self:SetClampedToScreen(true)
        self:RegisterForDrag("LeftButton")
        if self.Medal then
          self.Medal:SetTexture("Interface\\FriendsFrame\\StatusIcon-Online")
          self.Medal:Hide()
        end
      </OnLoad>
      <OnDragStart>
        if not InCombatLockdown or not InCombatLockdown() then
          self:StartMoving()
        end
      </OnDragStart>
      <OnDragStop>
        self:StopMovingOrSizing()
        if BanterCombat_SavePopupPosition then
          BanterCombat_SavePopupPosition(self)
        end
      </OnDragStop>
    </Scripts>
  </Frame>
</Ui>

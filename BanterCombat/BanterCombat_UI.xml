<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
  <Frame name="BanterCombatPopup" parent="UIParent" frameStrata="DIALOG" enableMouse="true" movable="true" hidden="true">
    <Size x="440" y="120"/>
    <Anchors>
      <Anchor point="BOTTOM" relativePoint="BOTTOM" x="0" y="160"/>
    </Anchors>
    <Layers>
      <Layer level="BACKGROUND">
        <Texture name="$parentEdgeGlow" parentKey="EdgeGlow" setAllPoints="true">
          <Color r="0.2" g="0.15" b="0.05" a="0.35"/>
        </Texture>
      </Layer>
      <Layer level="ARTWORK">
        <Texture name="$parentMedal" parentKey="Medal">
          <Size x="20" y="20"/>
          <Anchors>
            <Anchor point="TOPLEFT" x="14" y="-10"/>
          </Anchors>
        </Texture>
        <Texture name="$parentPortrait" parentKey="Portrait">
          <Size x="56" y="56"/>
          <Anchors>
            <Anchor point="LEFT" x="18" y="-6"/>
          </Anchors>
        </Texture>
        <FontString name="$parentBadge" parentKey="Badge" inherits="GameFontNormal" justifyH="LEFT">
          <Size x="360" y="16"/>
          <Anchors>
            <Anchor point="TOPLEFT" x="38" y="-12"/>
          </Anchors>
          <Color r="1" g="0.82" b="0.2" a="1"/>
        </FontString>
        <FontString name="$parentSpeaker" parentKey="Speaker" inherits="GameFontHighlight" justifyH="LEFT">
          <Size x="320" y="16"/>
          <Anchors>
            <Anchor point="TOPLEFT" relativeTo="$parentPortrait" relativePoint="TOPRIGHT" x="12" y="0"/>
          </Anchors>
        </FontString>
        <FontString name="$parentText" parentKey="Text" inherits="GameFontHighlightSmall" justifyH="LEFT" justifyV="TOP">
          <Size x="320" y="52"/>
          <Anchors>
            <Anchor point="TOPLEFT" relativeTo="$parentSpeaker" relativePoint="BOTTOMLEFT" x="0" y="-4"/>
          </Anchors>
        </FontString>
      </Layer>
    </Layers>
    <Frames>
      <PlayerModel name="$parentModel" parentKey="Model" hidden="true">
        <Size x="56" y="56"/>
        <Anchors>
          <Anchor point="LEFT" x="18" y="-6"/>
        </Anchors>
      </PlayerModel>
    </Frames>
    <Scripts>
      <OnLoad>
        self:SetClampedToScreen(true)
        self:RegisterForDrag("LeftButton")
        if self.SetBackdrop then
          self:SetBackdrop({
            bgFile = "Interface\\DialogFrame\\UI-DialogBox-Background-Dark",
            edgeFile = "Interface\\DialogFrame\\UI-DialogBox-Border",
            tile = true, tileSize = 32, edgeSize = 32,
            insets = { left = 11, right = 12, top = 12, bottom = 11 }
          })
          self:SetBackdropColor(0.08, 0.08, 0.1, 0.95)
        end
        if self.Medal then
          self.Medal:SetTexture("Interface\\FriendsFrame\\StatusIcon-Online")
          self.Medal:Hide()
        end
      </OnLoad>
      <OnDragStart>
        if not InCombatLockdown or not InCombatLockdown() then
          self:StartMoving()
        end
      </OnDragStart>
      <OnDragStop>
        self:StopMovingOrSizing()
        if BanterCombat_SavePopupPosition then
          BanterCombat_SavePopupPosition(self)
        end
      </OnDragStop>
    </Scripts>
  </Frame>
</Ui>

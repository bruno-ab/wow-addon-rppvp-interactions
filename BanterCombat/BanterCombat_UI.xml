<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
  <Frame name="BanterCombatPopup" parent="UIParent" frameStrata="DIALOG" enableMouse="true" movable="true" hidden="true">
    <Size x="460" y="118"/>
    <Anchors>
      <Anchor point="CENTER" relativePoint="CENTER" x="0" y="36"/>
    </Anchors>
    <Layers>
      <Layer level="BACKGROUND">
        <Texture name="$parentPaperTop" parentKey="PaperTop" hidden="true"/>
        <Texture name="$parentPaperMid" parentKey="PaperMid" hidden="true"/>
        <Texture name="$parentPaperBot" parentKey="PaperBot" hidden="true"/>
        <Texture name="$parentShade" parentKey="Shade" setAllPoints="true" file="Interface\Buttons\WHITE8X8">
          <Color r="0.03" g="0.03" b="0.04" a="0.94"/>
        </Texture>
        <Texture name="$parentCueWash" parentKey="CueWash" hidden="true" alphaMode="ADD">
          <Size x="160" y="118"/>
          <Anchors>
            <Anchor point="LEFT" x="0" y="0"/>
          </Anchors>
          <Color r="0.85" g="0.08" b="0.05" a="0.18"/>
        </Texture>
        <Texture name="$parentEdgeGlow" parentKey="EdgeGlow" hidden="true" setAllPoints="true">
          <Color r="0.55" g="0.14" b="0.12" a="0.2"/>
        </Texture>
        <Texture name="$parentKindBand" parentKey="KindBand" hidden="true">
          <Size x="3" y="118"/>
          <Anchors>
            <Anchor point="TOPLEFT" x="0" y="0"/>
            <Anchor point="BOTTOMLEFT" x="0" y="0"/>
          </Anchors>
          <Color r="0.9" g="0.22" b="0.14" a="1"/>
        </Texture>
      </Layer>
      <Layer level="BORDER">
        <Texture name="$parentPortraitShadow" parentKey="PortraitShadow" hidden="true">
          <Size x="72" y="72"/>
          <Anchors>
            <Anchor point="LEFT" x="14" y="4"/>
          </Anchors>
          <Color r="0" g="0" b="0" a="0.55"/>
        </Texture>
        <Texture name="$parentPortrait" parentKey="Portrait">
          <Size x="56" y="56"/>
          <Anchors>
            <Anchor point="LEFT" x="20" y="8"/>
          </Anchors>
        </Texture>
        <Texture name="$parentFactionRing" parentKey="FactionRing" hidden="true">
          <Size x="74" y="74"/>
          <Anchors>
            <Anchor point="CENTER" relativeTo="$parentPortrait" relativePoint="CENTER" x="0" y="0"/>
          </Anchors>
        </Texture>
        <Texture name="$parentRarityBarBg" parentKey="RarityBarBg" hidden="true">
          <Size x="330" y="2"/>
          <Anchors>
            <Anchor point="BOTTOMLEFT" x="96" y="10"/>
          </Anchors>
          <Color r="1" g="1" b="1" a="0.08"/>
        </Texture>
        <Texture name="$parentRarityBar" parentKey="RarityBar" hidden="true">
          <Size x="80" y="2"/>
          <Anchors>
            <Anchor point="LEFT" relativeTo="$parentRarityBarBg" relativePoint="LEFT" x="0" y="0"/>
          </Anchors>
          <Color r="1" g="0.75" b="0.25" a="0.95"/>
        </Texture>
        <Texture name="$parentDivider" parentKey="Divider" hidden="true">
          <Size x="300" y="1"/>
          <Anchors>
            <Anchor point="TOPLEFT" x="96" y="-34"/>
          </Anchors>
          <Color r="1" g="1" b="1" a="0.12"/>
        </Texture>
      </Layer>
      <Layer level="ARTWORK">
        <Texture name="$parentHeader" parentKey="Header" hidden="true"/>
        <FontString name="$parentStreakBig" parentKey="StreakBig" inherits="GameFontNormalHuge" justifyH="RIGHT" justifyV="MIDDLE" hidden="true">
          <Size x="150" y="70"/>
          <Anchors>
            <Anchor point="RIGHT" x="-14" y="6"/>
          </Anchors>
          <Color r="1" g="0.35" b="0.2" a="0.12"/>
        </FontString>
      </Layer>
      <Layer level="OVERLAY">
        <Texture name="$parentMedal" parentKey="Medal" hidden="true">
          <Size x="14" y="14"/>
          <Anchors>
            <Anchor point="TOPLEFT" x="96" y="-10"/>
          </Anchors>
        </Texture>
        <FontString name="$parentCombo" parentKey="Combo" inherits="GameFontNormalLarge" justifyH="LEFT" hidden="true">
          <Size x="300" y="22"/>
          <Anchors>
            <Anchor point="TOPLEFT" x="96" y="-8"/>
          </Anchors>
          <Color r="1" g="0.32" b="0.18" a="1"/>
        </FontString>
        <FontString name="$parentBadge" parentKey="Badge" inherits="GameFontNormal" justifyH="LEFT" hidden="true">
          <Size x="280" y="14"/>
          <Anchors>
            <Anchor point="TOPLEFT" x="96" y="-10"/>
          </Anchors>
        </FontString>
        <FontString name="$parentText" parentKey="Text" inherits="GameFontHighlight" justifyH="LEFT" justifyV="TOP">
          <Size x="310" y="36"/>
          <Anchors>
            <Anchor point="TOPLEFT" x="96" y="-36"/>
          </Anchors>
        </FontString>
        <FontString name="$parentSubject" parentKey="Subject" inherits="GameFontNormalSmall" justifyH="LEFT">
          <Size x="78" y="28"/>
          <Anchors>
            <Anchor point="TOP" relativeTo="$parentPortrait" relativePoint="BOTTOM" x="0" y="-2"/>
          </Anchors>
          <Color r="0.72" g="0.70" b="0.64" a="1"/>
        </FontString>
        <FontString name="$parentMeta" parentKey="Meta" inherits="GameFontDisableSmall" justifyH="RIGHT">
          <Size x="200" y="14"/>
          <Anchors>
            <Anchor point="TOPRIGHT" x="-14" y="-10"/>
          </Anchors>
          <Color r="0.55" g="0.55" b="0.50" a="1"/>
        </FontString>
        <FontString name="$parentSpeaker" parentKey="Speaker" inherits="GameFontNormalSmall" justifyH="LEFT">
          <Size x="310" y="14"/>
          <Anchors>
            <Anchor point="BOTTOMLEFT" x="96" y="14"/>
          </Anchors>
        </FontString>
        <Texture name="$parentFlash" parentKey="Flash" hidden="true" setAllPoints="true" alphaMode="ADD">
          <Color r="1" g="1" b="1" a="0"/>
        </Texture>
      </Layer>
    </Layers>
    <Frames>
      <PlayerModel name="$parentModel" parentKey="Model" hidden="true">
        <Size x="56" y="56"/>
        <Anchors>
          <Anchor point="LEFT" x="20" y="8"/>
        </Anchors>
      </PlayerModel>
    </Frames>
    <Scripts>
      <OnLoad>
        self:SetClampedToScreen(true)
        self:RegisterForDrag("LeftButton")
        if self.Medal then
          self.Medal:SetTexture("Interface\\FriendsFrame\\StatusIcon-Online")
          self.Medal:Hide()
        end
        if self.FactionRing then
          self.FactionRing:SetTexture("Interface\\Buttons\\UI-Quickslot2")
          self.FactionRing:SetTexCoord(0.2, 0.8, 0.2, 0.8)
          self.FactionRing:Hide()
        end
        if self.PortraitShadow then
          self.PortraitShadow:SetTexture("Interface\\Buttons\\WHITE8X8")
        end
        if self.Divider then
          self.Divider:SetTexture("Interface\\Buttons\\WHITE8X8")
        end
        if self.Shade then
          self.Shade:SetTexture("Interface\\Buttons\\WHITE8X8")
          self.Shade:SetVertexColor(0.03, 0.03, 0.04, 0.94)
          self.Shade:Show()
        end
        if self.Subject and self.Subject.SetWordWrap then
          self.Subject:SetWordWrap(true)
        end
        if self.Text and self.Text.SetWordWrap then
          self.Text:SetWordWrap(true)
        end
      </OnLoad>
      <OnDragStart>
        if not InCombatLockdown or not InCombatLockdown() then
          self:StartMoving()
        end
      </OnDragStart>
      <OnDragStop>
        self:StopMovingOrSizing()
        if BanterCombat_SavePopupPosition then
          BanterCombat_SavePopupPosition(self)
        end
      </OnDragStop>
    </Scripts>
  </Frame>
</Ui>

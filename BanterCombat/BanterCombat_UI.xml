<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
  <!-- Pop-up de provocação PvP — Classic Era / Hardcore -->
  <Frame name="BanterCombatPopup" parent="UIParent" frameStrata="DIALOG" enableMouse="false" hidden="true">
    <Size x="420" y="110"/>
    <Anchors>
      <Anchor point="BOTTOM" relativePoint="BOTTOM" x="0" y="160"/>
    </Anchors>
    <Layers>
      <Layer level="ARTWORK">
        <Texture name="$parentPortrait" parentKey="Portrait">
          <Size x="56" y="56"/>
          <Anchors>
            <Anchor point="LEFT" x="18" y="-2"/>
          </Anchors>
        </Texture>
        <FontString name="$parentBadge" parentKey="Badge" inherits="GameFontNormal" justifyH="CENTER">
          <Size x="380" y="16"/>
          <Anchors>
            <Anchor point="TOP" x="0" y="-10"/>
          </Anchors>
          <Color r="1" g="0.82" b="0.2" a="1"/>
        </FontString>
        <FontString name="$parentSpeaker" parentKey="Speaker" inherits="GameFontHighlight" justifyH="LEFT">
          <Size x="300" y="16"/>
          <Anchors>
            <Anchor point="TOPLEFT" relativeTo="$parentPortrait" relativePoint="TOPRIGHT" x="12" y="0"/>
          </Anchors>
        </FontString>
        <FontString name="$parentText" parentKey="Text" inherits="GameFontHighlightSmall" justifyH="LEFT" justifyV="TOP">
          <Size x="310" y="48"/>
          <Anchors>
            <Anchor point="TOPLEFT" relativeTo="$parentSpeaker" relativePoint="BOTTOMLEFT" x="0" y="-4"/>
          </Anchors>
        </FontString>
      </Layer>
    </Layers>
    <Scripts>
      <OnLoad>
        self:SetClampedToScreen(true)
        if self.SetBackdrop then
          self:SetBackdrop({
            bgFile = "Interface\\DialogFrame\\UI-DialogBox-Background-Dark",
            edgeFile = "Interface\\DialogFrame\\UI-DialogBox-Border",
            tile = true, tileSize = 32, edgeSize = 32,
            insets = { left = 11, right = 12, top = 12, bottom = 11 }
          })
          self:SetBackdropColor(0.08, 0.08, 0.1, 0.95)
        end
      </OnLoad>
    </Scripts>
  </Frame>
</Ui>
